        /* ==============================================================
           CONNECTIONS (anyone ↔ anyone)
           ============================================================== */
        // The connection between me and someone else (or undefined)
        function connectionWith(otherId) {
            const id = myId();
            return state.connections.find(c =>
                (c.requester === id && c.addressee === otherId) || (c.requester === otherId && c.addressee === id));
        }

        const otherSide = c => c.requester === myId() ? c.addressee : c.requester;

        function myConnections() {
            return state.connections
                .filter(c => c.status === 'accepted' && (c.requester === myId() || c.addressee === myId()))
                .map(c => users()[otherSide(c)])
                .filter(p => p && !hidden(p.id));
        }

        // The right button(s) for someone, depending on how we're connected
        function connectButton(other) {
            if (!other || other.id === myId()) return '';
            const c = connectionWith(other.id);
            if (!c) {
                return '<button class="btn btn-primary btn-sm" onclick="askToConnect(\'' + other.id + '\', this)">Connect</button>';
            }
            if (c.status === 'pending' && c.requester === myId()) {
                return '<span class="badge">Request sent</span>';
            }
            if (c.status === 'pending') {
                return '<button class="btn btn-primary btn-sm" onclick="answerRequest(\'' + c.id + '\', \'accepted\')">Accept</button>' +
                       '<button class="btn btn-ghost btn-sm" onclick="answerRequest(\'' + c.id + '\', \'declined\')">Decline</button>';
            }
            if (c.status === 'accepted') {
                return '<span class="badge ok">Connected</span>' +
                       '<button class="btn btn-secondary btn-sm" onclick="openChat(\'' + other.id + '\')">Message</button>';
            }
            return '<span class="small muted">Not connected</span>';
        }

        async function askToConnect(otherId, button) {
            if (button) button.disabled = true;
            const { error } = await db.connect(otherId);
            if (error) { toast(friendly(error)); if (button) button.disabled = false; return; }
            toast('Request sent to ' + users()[otherId].name.split(' ')[0]);
