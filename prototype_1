        const pickers = {};       // box id → { list: [...], on: Set, custom: true/false }

        function mountPicker(boxId, ideas, selected, custom) {
            const on = new Set(selected || []);
            const list = [...ideas];
            on.forEach(v => { if (!list.includes(v)) list.push(v); });
            pickers[boxId] = { list, on, custom: custom !== false };
            drawPicker(boxId);
        }

        function drawPicker(boxId) {
            const p = pickers[boxId];
            let html = '<div class="chip-list">' + p.list.map((v, i) =>
                '<button type="button" class="chip' + (p.on.has(v) ? ' on' : '') + '" onclick="pickToggle(\'' + boxId + '\', ' + i + ')">' + esc(v) + '</button>').join('') + '</div>';
