          <!-- 1f. Mentor availability box (time slots) -->
        </div>
      </div>
    </section>


    <!-- ========== SCREEN 2: CHAT ========== -->
    <section class="screen" id="chat">
      <!-- 2a. Heading row: eyebrow, title, subtitle, "Mutual match" tag -->

      <div class="columns">
        <!-- LEFT: chat box -->
        <div class="chatbox">
          <!-- 2b. Chat header: mentor avatar, name, role, Plan a session button -->

          <!-- 2c. Messages (id="messages"):
                   - day label
                   - Warm Start suggestion
                   - 3 starter messages -->

          <!-- 2d. Composer: message input + Send button -->
        </div>

        <!-- RIGHT: side panel -->
        <aside class="panel">
          <!-- 2e. Warm Start: progress bar + 3 steps (Ask, Try, Make it yours)
                   + "Choose a time" button -->
        </aside>
      </div>
    </section>


    <!-- ===================== ANGELINA: SCREENS 3-5 ===================== -->

    <!-- ========== SCREEN 3: SCHEDULE ========== -->
    <section class="screen" id="schedule">
      <!-- 3a. Heading row: eyebrow, title, subtitle -->

      <div class="schedule">
        <!-- 3b. Steps: 01 Match - 02 Plan - 03 Meet -->

        <!-- 3c. Calendar header: month + arrows -->

        <!-- 3d. 7 day boxes (Friday selected) -->

        <!-- 3e. Selected day label + 3 time buttons -->

        <!-- 3f. Bottom: session note + Confirm session button -->
      </div>
    </section>


    <!-- ========== SCREEN 4: PROJECT ROOM ========== -->
    <section class="screen" id="room">
      <!-- 4a. Heading row: eyebrow, title, subtitle, "Session in progress" tag -->

      <div class="room">
        <!-- 4b. Room top bar: session name, time, "Private room" tag -->

        <div class="roomgrid">
          <!-- LEFT: video area -->
          <div class="videoarea">
            <!-- 4c. Student video tile (mic, avatar, name) -->

            <!-- 4d. Mentor video tile (mic, avatar, name) -->

            <!-- 4e. Controls: Mute, Camera, React, Share, End session -->
          </div>

          <!-- RIGHT: side panel -->
          <div class="roomside">
            <!-- 4f. Mini activity: C-rate question + formula -->

            <!-- 4g. Answer box + Check button -->

            <!-- 4h. Session chat -->
          </div>
        </div>
      </div>
    </section>


