        }


        /* ---------- "IT'S A MATCH!" ----------
           Shows once for each new connection. */
        let seenMatches = null;
        const seenKey = () => 'ayx-seen-matches-' + myId();

        function checkNewMatches() {
            if (!me()) return;
            const accepted = state.connections.filter(c => c.status === 'accepted' && (c.requester === myId() || c.addressee === myId()));
            if (!seenMatches) {
                // First load: everything you already have counts as seen
                let saved = [];
                if (!DEMO) { try { saved = JSON.parse(localStorage.getItem(seenKey()) || '[]'); } catch (e) { saved = []; } }
                seenMatches = new Set([...saved, ...accepted.map(c => c.id)]);
                saveSeen();
                return;
            }
            const fresh = accepted.find(c => !seenMatches.has(c.id));
            if (!fresh) return;
            seenMatches.add(fresh.id);
            saveSeen();
            const other = users()[otherSide(fresh)];
            if (other && !hidden(other.id) && $('modalBack').classList.contains('hidden')) showMatch(other);
        }

        function saveSeen() {
            if (DEMO) return;
            try { localStorage.setItem(seenKey(), JSON.stringify([...seenMatches])); } catch (e) { /* private window */ }
        }

        function matchReason(other) {
            const topics = shared(me(), other, 'interests');
            const times = shared(me(), other, 'availability');
            const parts = [];
            if (topics.length) parts.push('You both care about ' + topics.slice(0, 2).join(' and '));
            if (times.length) parts.push((parts.length ? 'you\'re' : 'You\'re') + ' both free on ' + times[0].toLowerCase());
            return parts.length ? parts.join(', and ') + '.' : 'Say hi and plan your first chat.';
        }

        function showMatch(other) {
            openModal(
                '<div class="match">' +
                    '<div class="pair">' + avatar(me(), 'lg') + avatar(other, 'lg') + '</div>' +
                    '<h2>🎉 It\'s a match!</h2>' +
                    '<p class="muted">You and <b>' + esc(other.name) + '</b> are connected. ' + esc(matchReason(other)) + '</p>' +
                    '<div class="modal-actions">' +
                        '<button class="btn btn-secondary" onclick="closeModal()">Later</button>' +
                        '<button class="btn btn-primary" onclick="closeModal(); openChat(\'' + other.id + '\')">Say hi →</button>' +
                    '</div>' +
                '</div>');
        }


        /* ---------- BLOCK, REPORT, REMOVE ---------- */
