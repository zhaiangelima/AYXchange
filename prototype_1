        function mediaProblem(e) {
            if (!navigator.mediaDevices) return 'Open this page with Live Server (or https) to use your camera and mic.';
            if (e && e.name === 'NotAllowedError') return 'Access was blocked. Click the camera icon in your address bar to allow it.';
            if (e && e.name === 'NotFoundError') return 'No camera or mic was found on this device.';
            return 'Could not start it. Is another app using it?';
        }

        async function toggleCamera() {
            if (camStream) {
                camStream.getTracks().forEach(t => t.stop());
                camStream = null;
            } else {
                if (!navigator.mediaDevices) { toast(mediaProblem()); return; }
                try {
                    camStream = await navigator.mediaDevices.getUserMedia({ video: true });
                    $('myVideo').srcObject = camStream;
                } catch (e) { toast(mediaProblem(e)); camStream = null; }
            }
            $('myVideo').classList.toggle('hidden', !camStream);
            $('camBtn').textContent = camStream ? 'Turn off camera' : 'Turn on camera';
            $('camBtn').classList.toggle('on', !!camStream);
            renderRoom();
        }

        async function toggleMic() {
            if (micStream) {
                stopMic();
            } else {
                if (!navigator.mediaDevices) { toast(mediaProblem()); return; }
                try {
                    micStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    const analyser = audioCtx.createAnalyser();
                    analyser.fftSize = 256;
                    audioCtx.createMediaStreamSource(micStream).connect(analyser);
                    const data = new Uint8Array(analyser.frequencyBinCount);
                    const tick = () => {
                        analyser.getByteFrequencyData(data);
                        let sum = 0;
                        for (const v of data) sum += v;
                        $('micLevel').style.width = Math.min(100, (sum / data.length) * 2) + '%';
                        meterLoop = requestAnimationFrame(tick);
                    };
                    tick();
                } catch (e) { toast(mediaProblem(e)); micStream = null; }
            }
            $('micBtn').textContent = micStream ? 'Turn off mic' : 'Turn on mic';
            $('micBtn').classList.toggle('on', !!micStream);
            $('myStatus').textContent = micStream ? 'Mic on' : 'Mic off';
        }

        function stopMic() {
            if (micStream) micStream.getTracks().forEach(t => t.stop());
            micStream = null;
            if (meterLoop) cancelAnimationFrame(meterLoop);
            if (audioCtx) audioCtx.close();
            audioCtx = null;
            $('micLevel').style.width = '0';
        }

        function stopMedia() {
            if (camStream) {
