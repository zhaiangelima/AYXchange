        // ---------- AFTER SIGNING IN ----------
        async function openApp(user) {
            if (!user || recovering || signedInAs === user.id) return;
            signedInAs = user.id;

            const { data: profile, error } = await sb.from('profiles').select('*').eq('id', user.id).maybeSingle();
            if (error) { toast(friendly(error)); signedInAs = null; return; }

            if (!profile) {
