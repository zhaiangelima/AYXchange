        /* ==============================================================
           AVATARS
           Everyone builds a cute avatar. It's saved as a few small
           choices, like { hair: 'buns', eyes: 'sparkle', ... }.
           Picture order: uploaded photo → built avatar → initials.
           ============================================================== */
        const AV = {
            skin:      ['#FFE0C7', '#F6C9A5', '#E2A47C', '#C27F55', '#8D5A3B', '#5E3B26'],
            hairColor: ['#2B2220', '#6B4226', '#C98A4B', '#F2D27A', '#E58FB0', '#7FA7E8'],
            bg:        ['#DBE6FF', '#FFE1D6', '#DFF3E4', '#F0E1FF', '#FFF0C2', '#D8F1F5'],
            hair:      ['short', 'bob', 'buns', 'curly', 'long', 'none'],
            eyes:      ['dots', 'happy', 'sparkle', 'sleepy'],
            mouth:     ['smile', 'cat', 'open', 'tiny'],
            extra:     ['none', 'glasses', 'bow', 'hard hat', 'grad cap', 'headphones']
        };
        const AV_LABELS = { skin: 'Skin', hair: 'Hair', hairColor: 'Hair color', eyes: 'Eyes', mouth: 'Mouth', extra: 'Extra', bg: 'Background' };

        const pick = list => list[Math.floor(Math.random() * list.length)];
        const pickIndex = list => Math.floor(Math.random() * list.length);

        function randomAvatar() {
            return {
                skin: pickIndex(AV.skin), hairColor: pickIndex(AV.hairColor), bg: pickIndex(AV.bg),
                hair: pick(AV.hair.slice(0, 5)), eyes: pick(AV.eyes), mouth: pick(AV.mouth),
                extra: Math.random() < 0.5 ? 'none' : pick(AV.extra), blush: Math.random() > 0.25
            };
        }

        // Fix anything missing or strange in a saved avatar
        function cleanAvatar(a) {
            a = a || {};
            const num = (v, list) => Number.isInteger(v) && v >= 0 && v < list.length ? v : 0;
            const one = (v, list) => list.includes(v) ? v : list[0];
            return {
                skin: num(a.skin, AV.skin), hairColor: num(a.hairColor, AV.hairColor), bg: num(a.bg, AV.bg),
                hair: one(a.hair, AV.hair), eyes: one(a.eyes, AV.eyes), mouth: one(a.mouth, AV.mouth),
                extra: one(a.extra, AV.extra), blush: a.blush !== false
            };
        }

        let avCount = 0;
        function avatarSvg(input) {
            const a = cleanAvatar(input);
            const hc = AV.hairColor[a.hairColor], sk = AV.skin[a.skin], id = 'avc' + (++avCount);
            const dark = '#2B2220', lip = '#7A3B2E';

            let back = '';
            if (a.hair === 'long') back = `<path d="M36 78 Q34 40 80 34 Q126 40 124 78 L128 132 Q80 142 32 132 Z" fill="${hc}"/>`;
            if (a.hair === 'bob') back = `<path d="M34 80 Q32 38 80 34 Q128 38 126 80 L126 108 Q122 116 112 112 L48 112 Q38 116 34 108 Z" fill="${hc}"/>`;

            const top = `<path d="M38 74 Q38 34 80 32 Q122 34 122 74 Q112 54 92 52 Q86 60 72 56 Q52 54 38 74Z" fill="${hc}"/>`;
            let front = top;
            if (a.hair === 'none') front = '';
            if (a.hair === 'buns') front = `<circle cx="50" cy="38" r="15" fill="${hc}"/><circle cx="110" cy="38" r="15" fill="${hc}"/>` + top;
            if (a.hair === 'curly') front = [[44, 62], [50, 46], [64, 36], [80, 32], [96, 36], [110, 46], [116, 62]]
                .map(p => `<circle cx="${p[0]}" cy="${p[1]}" r="13" fill="${hc}"/>`).join('');

            let eyes = `<circle cx="64" cy="82" r="4.5" fill="${dark}"/><circle cx="96" cy="82" r="4.5" fill="${dark}"/>`;
            if (a.eyes === 'happy') eyes = `<path d="M58 84 Q64 76 70 84 M90 84 Q96 76 102 84" stroke="${dark}" stroke-width="3.5" fill="none" stroke-linecap="round"/>`;
            if (a.eyes === 'sleepy') eyes = `<path d="M58 82 Q64 88 70 82 M90 82 Q96 88 102 82" stroke="${dark}" stroke-width="3.5" fill="none" stroke-linecap="round"/>`;
            if (a.eyes === 'sparkle') eyes = `<circle cx="64" cy="82" r="7" fill="${dark}"/><circle cx="96" cy="82" r="7" fill="${dark}"/>` +
                `<circle cx="66.5" cy="79" r="2.6" fill="#fff"/><circle cx="98.5" cy="79" r="2.6" fill="#fff"/>` +
                `<circle cx="62" cy="85" r="1.2" fill="#fff"/><circle cx="94" cy="85" r="1.2" fill="#fff"/>`;

            let mouth = `<path d="M70 97 Q80 108 90 97" stroke="${lip}" stroke-width="3" fill="none" stroke-linecap="round"/>`;
            if (a.mouth === 'cat') mouth = `<path d="M72 98 Q76 104 80 98 Q84 104 88 98" stroke="${lip}" stroke-width="3" fill="none" stroke-linecap="round"/>`;
            if (a.mouth === 'open') mouth = `<path d="M72 97 Q80 99 88 97 Q86 110 80 110 Q74 110 72 97Z" fill="${lip}"/><ellipse cx="80" cy="106" rx="4" ry="2.5" fill="#F08A8A"/>`;
            if (a.mouth === 'tiny') mouth = `<ellipse cx="80" cy="100" rx="3" ry="2.4" fill="${lip}"/>`;

            const blush = a.blush ? '<ellipse cx="54" cy="96" rx="8" ry="5" fill="#FF8FA3" opacity="0.55"/><ellipse cx="106" cy="96" rx="8" ry="5" fill="#FF8FA3" opacity="0.55"/>' : '';

            const extras = {
                'none': '',
                'glasses': '<g stroke="#3A2E2A" stroke-width="3" fill="none"><circle cx="64" cy="82" r="11"/><circle cx="96" cy="82" r="11"/><path d="M75 82 Q80 78 85 82"/></g>',
                'bow': '<g fill="#F27BA0"><path d="M100 40 L118 30 L116 52 Z"/><path d="M100 40 L84 30 L86 52 Z"/><circle cx="100" cy="41" r="5" fill="#E05A86"/></g>',
                'hard hat': '<path d="M36 62 Q38 28 80 26 Q122 28 124 62 Z" fill="#FFC93C"/><rect x="30" y="58" width="100" height="9" rx="4.5" fill="#F2B21B"/><rect x="76" y="27" width="8" height="32" rx="3" fill="#F2B21B"/>',
                'grad cap': '<path d="M80 18 L128 34 L80 50 L32 34 Z" fill="#2B2220"/><path d="M56 42 L56 54 Q80 64 104 54 L104 42 L80 50 Z" fill="#3A2E2A"/><path d="M118 31 L118 52" stroke="#FFC93C" stroke-width="2.5"/><circle cx="118" cy="54" r="3.5" fill="#FFC93C"/>',
                'headphones': '<path d="M36 82 Q36 30 80 30 Q124 30 124 82" stroke="#7B6CF0" stroke-width="7" fill="none" stroke-linecap="round"/><rect x="28" y="74" width="14" height="24" rx="7" fill="#7B6CF0"/><rect x="118" y="74" width="14" height="24" rx="7" fill="#7B6CF0"/>'
            };

            return `<svg viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">` +
                `<clipPath id="${id}"><circle cx="80" cy="80" r="80"/></clipPath><g clip-path="url(#${id})">` +
                `<rect width="160" height="160" fill="${AV.bg[a.bg]}"/>${back}` +
                `<path d="M34 160 Q36 122 80 120 Q124 122 126 160Z" fill="#FFFFFF" opacity="0.9"/>` +
                `<rect x="72" y="108" width="16" height="16" rx="6" fill="${sk}"/>` +
                `<circle cx="38" cy="86" r="7" fill="${sk}"/><circle cx="122" cy="86" r="7" fill="${sk}"/>` +
                `<ellipse cx="80" cy="80" rx="43" ry="41" fill="${sk}"/>${front}${eyes}${blush}${mouth}${extras[a.extra]}` +
                `</g></svg>`;
        }

        // Round picture for a person
        const PASTELS = ['#dbe6ff', '#ffe1d6', '#dff3e4', '#f0e1ff', '#fff0c2', '#d8f1f5'];
        function avatar(u, size) {
            const cls = 'avatar' + (size ? ' ' + size : '');
            if (!u) return '<div class="' + cls + '" style="background:#eee">?</div>';
            if (u.photo) return '<div class="' + cls + '"><img src="' + esc(u.photo) + '" alt=""></div>';
            if (u.avatar) return '<div class="' + cls + '">' + avatarSvg(u.avatar) + '</div>';
            const initials = (u.name || '?').split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
            let n = 0;
            for (const ch of String(u.id)) n += ch.charCodeAt(0);
            return '<div class="' + cls + '" style="background:' + PASTELS[n % PASTELS.length] + '">' + esc(initials) + '</div>';
