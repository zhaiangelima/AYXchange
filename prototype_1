<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AYXchange</title>

    <style>
        /* ==========================================================
           1. COLORS + BASICS
           ========================================================== */
        :root {
            --bg: #f6f7f9;          /* page background */
            --surface: #ffffff;     /* panels */
            --text: #15171c;        /* main text */
            --muted: #687080;       /* secondary text */
            --faint: #9aa1ad;       /* hints */
            --line: #e3e6eb;        /* borders */
            --blue: #2c5be8;        /* main color */
            --blue-dark: #1f45bd;   /* button hover */
            --blue-tint: #edf1fd;   /* selected things */
            --danger: #c93c3c;
            --ok: #1d7a4c;
            --ok-tint: #e8f5ee;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            font-size: 15px;
            line-height: 1.5;
        }

        h1 { font-size: 24px; margin: 0 0 4px; letter-spacing: -0.3px; }
        h2 { font-size: 17px; margin: 0; }
        h3 { font-size: 15px; margin: 0 0 6px; }
        p { margin: 0; }
        .muted { color: var(--muted); }
        .small { font-size: 13px; }
        .hidden { display: none !important; }


        /* ==========================================================
           2. BUTTONS + INPUTS
           ========================================================== */
        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 6px;
            height: 38px; padding: 0 16px;
            border-radius: 8px; border: 1px solid transparent;
            font: inherit; font-size: 14px; font-weight: 600;
            cursor: pointer; white-space: nowrap;
        }
        .btn-primary { background: var(--blue); color: #fff; }
        .btn-primary:hover { background: var(--blue-dark); }
        .btn-secondary { background: var(--surface); color: var(--text); border-color: var(--line); }
        .btn-secondary:hover { background: var(--bg); }
        .btn-ghost { background: transparent; color: var(--muted); }
        .btn-ghost:hover { color: var(--text); }
        .btn-danger { background: var(--danger); color: #fff; }
        .btn-block { width: 100%; }
        .btn-sm { height: 32px; padding: 0 12px; font-size: 13px; }
        .btn:disabled { opacity: 0.55; cursor: default; }
        .btn.on { background: var(--blue-tint); border-color: var(--blue); color: var(--blue-dark); }

        .field { display: block; margin-bottom: 14px; }
        .field span { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
        input, select, textarea {
            width: 100%;
            font: inherit; font-size: 15px; color: var(--text);
            background: var(--surface);
            border: 1px solid var(--line); border-radius: 8px;
            padding: 9px 12px;
        }
        input:focus, select:focus, textarea:focus {
            outline: none; border-color: var(--blue);
            box-shadow: 0 0 0 3px var(--blue-tint);
        }
        textarea { resize: vertical; }
        input:disabled { background: var(--bg); color: var(--muted); }
        .error { color: var(--danger); font-size: 13px; min-height: 20px; margin: -4px 0 8px; }


        /* ==========================================================
           3. SHARED PIECES
           ========================================================== */
        .panel {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 12px;
        }

        /* Round profile picture (photo, avatar, or initials) */
        .avatar {
            width: 40px; height: 40px; flex: none;
            border-radius: 50%; overflow: hidden;
            display: grid; place-items: center;
            font-weight: 700; font-size: 14px; color: #2a2f3a;
        }
        .avatar img { width: 100%; height: 100%; object-fit: cover; }
        .avatar.sm { width: 32px; height: 32px; font-size: 12px; }
        .avatar.lg { width: 96px; height: 96px; font-size: 30px; }

        .logo-row { display: flex; align-items: center; gap: 8px; cursor: pointer; }
        .logo-mark {
            width: 28px; height: 28px; border-radius: 7px;
            background: var(--blue); color: #fff;
            display: grid; place-items: center;
            font-weight: 800; font-size: 15px;
        }
        .logo-text { font-weight: 700; font-size: 18px; letter-spacing: -0.3px; }

        .badge {
            display: inline-block; font-size: 12px; font-weight: 600;
            padding: 2px 8px; border-radius: 99px;
            background: var(--blue-tint); color: var(--blue-dark);
        }
        .badge.ok { background: var(--ok-tint); color: var(--ok); }

        .empty-state { padding: 36px 20px; text-align: center; color: var(--muted); }
        .empty-state h3 { color: var(--text); }

        .toast {
            position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%);
            background: var(--text); color: #fff;
            padding: 10px 16px; border-radius: 8px; font-size: 14px;
            opacity: 0; transition: opacity 0.2s; pointer-events: none; z-index: 70;
        }
        .toast.show { opacity: 1; }


        /* ==========================================================
           4. SIGN-IN PAGE
           ========================================================== */
        .auth { min-height: 100vh; display: grid; place-items: center; padding: 24px 16px; }
        .auth-box { width: 100%; max-width: 400px; }
        .auth-box > .logo-row { justify-content: center; margin-bottom: 20px; cursor: default; }
        .auth-panel { padding: 28px; }
        .auth-panel h1 { font-size: 21px; }
        .auth-panel .muted { margin-bottom: 20px; }
        .auth-panel .segmented { margin-bottom: 20px; }
        .auth .fine { text-align: center; font-size: 12px; color: var(--faint); margin-top: 14px; }
        .back { display: block; background: none; border: 0; padding: 0; margin-bottom: 14px; color: var(--muted); font: inherit; font-size: 13px; cursor: pointer; }
        .setup-warning {
            border: 1px solid #f0c36d; background: #fff8e6; color: #7a5200;
            border-radius: 8px; padding: 10px 12px; font-size: 13px; margin-bottom: 16px;
        }

        .link-btn {
            display: block; margin: 14px auto 0; border: 0; background: none; cursor: pointer;
            font: inherit; font-size: 14px; font-weight: 600; color: var(--blue);
        }

        /* Student / Mentor switch (also Video / In person) */
        .segmented { display: grid; grid-template-columns: 1fr 1fr; background: var(--bg); border-radius: 9px; padding: 3px; margin-bottom: 16px; }
        .segmented button {
            border: 0; background: transparent; border-radius: 7px; padding: 8px;
            font: inherit; font-size: 14px; font-weight: 600; color: var(--muted); cursor: pointer;
        }
        .segmented button.on { background: var(--surface); color: var(--text); box-shadow: 0 1px 2px rgba(0,0,0,0.08); }


        /* ==========================================================
           5. HEADER + TABS
           ========================================================== */
        .header { background: var(--surface); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10; }
        .header-inner {
            max-width: 1040px; margin: 0 auto; padding: 0 20px;
            display: flex; align-items: center; gap: 24px; height: 60px;
        }
        .tabs { display: flex; gap: 4px; height: 100%; flex: 1; overflow-x: auto; }
        .tabs button {
            height: 100%; border: 0; background: none; padding: 0 12px;
            font: inherit; font-size: 14px; font-weight: 600; color: var(--muted);
            border-bottom: 2px solid transparent; cursor: pointer; white-space: nowrap;
        }
        .tabs button:hover { color: var(--text); }
        .tabs button.on { color: var(--text); border-bottom-color: var(--blue); }

        .me-spot { position: relative; }
        .avatar-btn { border: 0; padding: 0; background: none; cursor: pointer; border-radius: 50%; }
        .menu {
            position: absolute; right: 0; top: 48px; width: 250px; z-index: 20;
            background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
            box-shadow: 0 8px 24px rgba(20, 24, 33, 0.12); padding: 6px;
        }
        .menu-head { display: flex; gap: 10px; align-items: center; padding: 10px; border-bottom: 1px solid var(--line); margin-bottom: 6px; }
        .menu-head b { display: block; font-size: 14px; }
        .menu-item {
            display: block; width: 100%; text-align: left; border: 0; background: none;
            padding: 9px 10px; border-radius: 8px; font: inherit; font-size: 14px; color: var(--text); cursor: pointer;
        }
        .menu-item:hover { background: var(--bg); }
        .menu-item.danger { color: var(--danger); }


        /* ==========================================================
           6. PAGE LAYOUT
           ========================================================== */
        .page { max-width: 1040px; margin: 0 auto; padding: 28px 20px 60px; }
        .screen { display: none; }
        .screen.on { display: block; }
        .page-head { margin-bottom: 20px; }

        .two-col { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 20px; align-items: start; }
        .col-main { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
        .col-side { display: flex; flex-direction: column; gap: 16px; }
        .side-card { padding: 18px; }
        .side-card h3 { margin-bottom: 10px; }


        /* ==========================================================
           7. HOME: composer, feed, requests
           ========================================================== */
        .composer { padding: 16px; }
        .composer-row { display: flex; gap: 12px; }
        .composer textarea { border: 0; padding: 8px 0; box-shadow: none; min-height: 70px; }
        .composer-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; border-top: 1px solid var(--line); padding-top: 12px; margin-top: 6px; }

        .feed-title { padding: 14px 18px; border-bottom: 1px solid var(--line); font-weight: 600; }
        .post { padding: 18px; border-bottom: 1px solid var(--line); }
        .post:last-child { border-bottom: 0; }
        .post-head { display: flex; gap: 12px; align-items: center; margin-bottom: 10px; }
        .post-head b { display: block; font-size: 15px; }
        .post-text { white-space: pre-wrap; word-wrap: break-word; margin-bottom: 12px; }
        .post-foot { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }

        .person-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; }
        .person-row + .person-row { border-top: 1px solid var(--line); }
        .person-row .grow { flex: 1; min-width: 0; }
        .person-row b { display: block; font-size: 14px; }
        .person-row .actions { display: flex; gap: 6px; }


        /* People page */
        .people-bar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 12px; }
        .people-bar input { flex: 1; min-width: 220px; }
        .filter { display: flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: #fff; }
        .filter button { border: 0; background: none; padding: 9px 14px; font: inherit; font-size: 14px; color: var(--muted); cursor: pointer; }
        .filter button + button { border-left: 1px solid var(--line); }
        .filter button.on { background: var(--blue-tint); color: var(--blue-dark); font-weight: 600; }
        .people-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
        .person-card { padding: 16px; display: flex; flex-direction: column; gap: 10px; }
        .person-card .top { display: flex; gap: 12px; align-items: center; }
        .person-card .grow { flex: 1; min-width: 0; }
        .person-card b { display: block; }
        .person-card .bio { flex: 1; margin: 0; }
        .post-head .badge { margin-left: 6px; vertical-align: 1px; }


        /* ==========================================================
           8. MESSAGES
           ========================================================== */
        .chat {
            display: grid; grid-template-columns: 260px minmax(0, 1fr);
            grid-template-rows: minmax(0, 1fr);            /* the chat can't grow taller than its box */
            height: calc(100vh - 190px); min-height: 420px; max-height: 720px;
            overflow: hidden;
        }
        .chat-list { border-right: 1px solid var(--line); overflow-y: auto; padding: 8px; }
        .contact {
            display: flex; gap: 10px; align-items: center; width: 100%; text-align: left;
            border: 0; background: none; border-radius: 8px; padding: 10px;
            font: inherit; color: var(--text); cursor: pointer;
        }
        .contact:hover { background: var(--bg); }
        .contact.on { background: var(--blue-tint); }
        .contact b { display: block; font-size: 14px; }
        .contact .preview { display: block; font-size: 13px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .contact .grow { min-width: 0; }

        .chat-main { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
        .chat-head { display: flex; gap: 10px; align-items: center; padding: 12px 18px; border-bottom: 1px solid var(--line); min-height: 64px; }
        .chat-head b { display: block; }
        .chat-body { flex: 1; min-height: 0; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 6px; }   /* scrolls */
        .msg { max-width: 72%; }
        .msg .bubble { padding: 9px 13px; border-radius: 16px; background: #eff1f4; white-space: pre-wrap; word-wrap: break-word; }
        .msg.mine { align-self: flex-end; }
        .msg.mine .bubble { background: var(--blue); color: #fff; }
        .msg .time { font-size: 11px; color: var(--faint); margin: 2px 6px 6px; }
        .msg.mine .time { text-align: right; }
        .msg.typing .bubble { color: var(--muted); font-style: italic; }

        .chips { display: flex; gap: 8px; padding: 0 18px 10px; overflow-x: auto; }
        .chips button {
            flex: none; border: 1px solid var(--line); background: var(--surface); border-radius: 99px;
            padding: 6px 12px; font: inherit; font-size: 13px; color: var(--text); cursor: pointer;
        }
        .chips button:hover { border-color: var(--blue); color: var(--blue-dark); }
        .chat-compose { display: flex; gap: 8px; padding: 12px 18px 16px; border-top: 1px solid var(--line); }


        /* ==========================================================
           9. SESSIONS: calendar
           ========================================================== */
        .cal { padding: 20px; }
        .cal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
        .icon-btn {
            width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--line);
            background: var(--surface); font-size: 18px; cursor: pointer; color: var(--text);
        }
        .icon-btn:hover { background: var(--bg); }
        .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
        .cal-dow { text-align: center; font-size: 12px; font-weight: 600; color: var(--faint); padding-bottom: 6px; }
        .day {
            position: relative; aspect-ratio: 1 / 1; max-height: 52px;
            border: 0; background: none; border-radius: 8px;
            font: inherit; font-size: 14px; color: var(--text); cursor: pointer;
        }
        .day:hover:not(:disabled) { background: var(--bg); }
        .day:disabled { color: #c4c8cf; cursor: default; }
        .day.today { font-weight: 700; color: var(--blue); }
        .day.picked { background: var(--blue); color: #fff; }
        .day .dot { position: absolute; left: 50%; bottom: 6px; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: var(--blue); }
        .day.picked .dot { background: #fff; }

        .book { border-top: 1px solid var(--line); margin-top: 16px; padding-top: 16px; }
        .times { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 8px; margin: 10px 0 16px; }
        .time-btn {
            height: 36px; border: 1px solid var(--line); background: var(--surface); border-radius: 8px;
            font: inherit; font-size: 13px; font-weight: 600; color: var(--text); cursor: pointer;
        }
        .time-btn:hover:not(:disabled) { border-color: var(--blue); }
        .time-btn.picked { background: var(--blue); border-color: var(--blue); color: #fff; }
        .time-btn:disabled { color: #c4c8cf; text-decoration: line-through; cursor: default; }

        .meeting { padding: 12px 0; border-top: 1px solid var(--line); }
        .meeting .when { font-weight: 600; font-size: 14px; }
        .meeting .row { display: flex; gap: 6px; margin-top: 8px; align-items: center; }


        /* ==========================================================
           10. ROOM: real camera + mic
           ========================================================== */
        .room-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; align-items: start; }
        .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .tile {
            position: relative; aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden;
            background: #1f232b; display: grid; place-items: center;
        }
        .tile video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
        .tile-name {
            position: absolute; left: 10px; bottom: 10px;
            background: rgba(0,0,0,0.55); color: #fff; font-size: 12px; font-weight: 600;
            padding: 3px 8px; border-radius: 6px;
        }
        .tile-status {
            position: absolute; right: 10px; top: 10px;
            background: rgba(0,0,0,0.55); color: #fff; font-size: 11px; padding: 3px 8px; border-radius: 6px;
        }
        .tile-wait { position: absolute; left: 0; right: 0; bottom: 40px; text-align: center; color: #b9bfca; font-size: 13px; padding: 0 12px; }

        .meter-row { display: flex; align-items: center; gap: 10px; margin: 14px 0; }
        .meter { flex: 1; height: 6px; background: var(--line); border-radius: 99px; overflow: hidden; }
        .meter div { height: 100%; width: 0; background: var(--ok); transition: width 0.08s; }
        .controls { display: flex; gap: 8px; flex-wrap: wrap; }
        .room-note { margin-top: 12px; }


        /* ==========================================================
           11. NOTES
           ========================================================== */
        .note-card { padding: 18px; margin-bottom: 14px; }
        .note-card .goal { background: var(--blue-tint); border-radius: 8px; padding: 10px 12px; margin: 10px 0; font-weight: 600; }
        .note-card .text { white-space: pre-wrap; color: var(--text); }


        /* ==========================================================
           11b. PROFILE + SETTINGS
           ========================================================== */
        .file-row {
            display: flex; align-items: center; gap: 12px;
            border: 1px solid var(--line); border-radius: 10px; padding: 12px; margin: 12px 0;
        }
        .file-icon {
            width: 40px; height: 48px; flex: none; border-radius: 6px;
            background: #fdecec; color: var(--danger);
            display: grid; place-items: center; font-size: 11px; font-weight: 800;
        }
        .file-row .grow { flex: 1; min-width: 0; }
        .file-row b { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .bio { font-size: 13px; color: var(--muted); margin-top: 2px; }
        .stack { display: flex; flex-direction: column; gap: 16px; }


        /* Member ID */
        .id-chip {
            display: inline-flex; align-items: center; gap: 6px;
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; font-weight: 600;
            background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 2px 8px; color: var(--text);
        }
        .find-box { padding: 18px; margin-bottom: 20px; }
        .find-row { display: flex; gap: 8px; margin: 10px 0 4px; }
        .find-row input { max-width: 280px; text-transform: uppercase; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
        .find-result { margin-top: 14px; }
        .find-result .person-card { max-width: 420px; }
        .id-field { margin-bottom: 14px; }
        .id-field > b { display: block; font-size: 13px; margin-bottom: 6px; }
        .browse-title { font-size: 15px; margin: 4px 0 12px; }

        /* Resume review */
        .review { border-top: 1px solid var(--line); margin-top: 16px; padding-top: 16px; }
        .score-row { display: flex; align-items: baseline; gap: 10px; margin-bottom: 8px; }
        .score { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; }
        .score-bar { height: 6px; background: var(--line); border-radius: 99px; overflow: hidden; margin-bottom: 14px; }
        .score-bar div { height: 100%; background: var(--blue); }
        .review h4 { font-size: 13px; margin: 14px 0 6px; }
        .review ul { margin: 0; padding-left: 18px; }
        .review li { font-size: 14px; margin-bottom: 6px; }
        .review li .quote { display: block; font-size: 12px; color: var(--muted); font-style: italic; }
        .review .good li::marker { color: var(--ok); }
        .review .fix li::marker { color: var(--danger); }


        /* ==========================================================
           12. ABOUT PAGE (what AYXchange does)
           ========================================================== */
        .landing { min-height: 100vh; background: var(--surface); }
        .landing .header-inner { justify-content: space-between; }
        .landing-actions { display: flex; gap: 8px; }
        .landing-main { max-width: 1040px; margin: 0 auto; padding: 56px 20px 40px; }
        .hero { max-width: 640px; margin-bottom: 56px; }
        .hero h1 { font-size: 38px; line-height: 1.15; letter-spacing: -0.8px; margin-bottom: 14px; }
        .hero p { font-size: 17px; color: var(--muted); margin-bottom: 24px; }
        .hero .row { display: flex; gap: 10px; flex-wrap: wrap; }
        .landing h2 { font-size: 20px; margin-bottom: 16px; }
        .landing-section { margin-bottom: 52px; }
        .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
        .feature { padding: 18px; background: var(--bg); border-radius: 10px; }
        .feature h3 { margin-bottom: 4px; }
        .feature p { font-size: 14px; color: var(--muted); }
        .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
        .steps li { border-top: 2px solid var(--blue); padding-top: 12px; font-size: 14px; color: var(--muted); }
        .steps b { display: block; color: var(--text); font-size: 15px; margin-bottom: 4px; }
        .who { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        .who .panel { padding: 20px; }
        .who ul { margin: 8px 0 0; padding-left: 18px; color: var(--muted); font-size: 14px; }
        .who li { margin-bottom: 4px; }
        .landing-foot { border-top: 1px solid var(--line); padding: 20px; text-align: center; font-size: 13px; color: var(--faint); }


        /* ==========================================================
           13. SMALLER SCREENS
           ========================================================== */
        @media (max-width: 860px) {
            .two-col, .room-grid { grid-template-columns: 1fr; }
            .chat { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); height: auto; max-height: none; }
            .chat-list { border-right: 0; border-bottom: 1px solid var(--line); display: flex; overflow-x: auto; }
            .contact { width: auto; flex: none; }
            .contact .preview { display: none; }
            .chat-body { height: 380px; flex: none; }
            .feature-grid, .steps { grid-template-columns: 1fr 1fr; }
            .who { grid-template-columns: 1fr; }
        }
        @media (max-width: 560px) {
            .header-inner { gap: 12px; padding: 0 12px; }
            .logo-text { display: none; }
            .page { padding: 20px 14px 48px; }
            .tiles { grid-template-columns: 1fr; }
            .hero h1 { font-size: 30px; }
            .feature-grid, .steps { grid-template-columns: 1fr; }
        }


        /* ==========================================================
           14. NEW PIECES: avatars, chips, reactions, pop-ups, demo
           ========================================================== */
        input[type="checkbox"] { width: auto; }
        .avatar svg { width: 100%; height: 100%; display: block; }
        .avatar.xl { width: 128px; height: 128px; font-size: 40px; }

        /* Demo banner */
        .demo-bar { background: #fff6d6; color: #7a5200; text-align: center; font-size: 13px; padding: 6px 12px; }
        .demo-bar button { border: 0; background: none; color: #7a5200; font: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; }

        /* Tap-on/off chips (interests, skills, free times) */
        .chip-list { display: flex; flex-wrap: wrap; gap: 6px; }
        .chip {
            border: 1px solid var(--line); background: var(--surface); border-radius: 99px;
            padding: 5px 11px; font: inherit; font-size: 13px; color: var(--text); cursor: pointer;
        }
        .chip:hover { border-color: var(--blue); }
        .chip.on { background: var(--blue-tint); border-color: var(--blue); color: var(--blue-dark); font-weight: 600; }
        .chip.static { cursor: default; }
        .chip.static:hover { border-color: var(--line); }
        .chip.shared { background: var(--ok-tint); border-color: #a9dcc0; color: var(--ok); font-weight: 600; }
        .tag-add { display: flex; gap: 6px; margin-top: 8px; }
        .tag-add input { max-width: 220px; height: 32px; padding: 4px 10px; font-size: 13px; }
        .field-label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
        .field-block { margin-bottom: 16px; }

        /* Moments reactions */
        .reactions { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
        .react {
            border: 1px solid var(--line); background: var(--surface); border-radius: 99px;
            padding: 2px 10px; font: inherit; font-size: 15px; cursor: pointer; line-height: 1.6;
        }
        .react:hover { border-color: var(--blue); }
        .react.on { background: var(--blue-tint); border-color: var(--blue); }
        .react span { font-size: 12px; color: var(--muted); margin-left: 3px; font-weight: 600; }
        .counter { font-size: 12px; color: var(--faint); }
        .counter.over { color: var(--danger); }

        /* Avatar maker */
        .av-maker { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 18px; align-items: start; }
        .av-preview { background: var(--bg); border-radius: 12px; padding: 14px 10px; text-align: center; }
        .av-preview .avatar { margin: 0 auto 10px; }
        .av-row { margin-bottom: 10px; }
        .av-row .lab { font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 5px; }
        .av-opts { display: flex; flex-wrap: wrap; gap: 6px; }
        .sw { width: 26px; height: 26px; border-radius: 50%; border: 1px solid rgba(0, 0, 0, 0.12); cursor: pointer; padding: 0; }
        .sw.on { box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--blue); }
        .av-wiggle { animation: wiggle 0.35s ease; }
        @keyframes wiggle { 0% { transform: scale(1); } 40% { transform: scale(1.08) rotate(-3deg); } 100% { transform: scale(1); } }

        /* Pop-up window */
        .modal-back {
            position: fixed; inset: 0; z-index: 60; padding: 16px;
            background: rgba(20, 24, 33, 0.45); display: grid; place-items: center;
        }
        .modal {
            background: var(--surface); border-radius: 14px; width: 100%; max-width: 440px;
            padding: 24px; max-height: 90vh; overflow-y: auto;
            box-shadow: 0 20px 50px rgba(20, 24, 33, 0.25);
        }
        .modal h2 { margin-bottom: 6px; font-size: 19px; }
        .modal .muted { margin-bottom: 16px; }
        .modal-actions { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; margin-top: 8px; }

        /* "It's a match!" */
        .match { text-align: center; }
        .match .pair { display: flex; justify-content: center; margin: 6px 0 14px; }
        .match .pair .avatar { border: 4px solid var(--surface); }
        .match .pair .avatar + .avatar { margin-left: -18px; }
        .match .pair .avatar:first-child { animation: slideL 0.5s ease; }
        .match .pair .avatar:last-child { animation: slideR 0.5s ease; }
        .match h2 { font-size: 24px; animation: pop 0.5s ease; }
        .match .modal-actions { justify-content: center; }
        @keyframes slideL { from { transform: translateX(-40px); opacity: 0; } to { transform: none; opacity: 1; } }
        @keyframes slideR { from { transform: translateX(40px); opacity: 0; } to { transform: none; opacity: 1; } }
        @keyframes pop { 0% { transform: scale(0.6); opacity: 0; } 70% { transform: scale(1.08); } 100% { transform: scale(1); opacity: 1; } }

        /* People filters */
        .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
        .filters select { width: auto; min-width: 160px; padding: 7px 10px; font-size: 14px; }
        .free { font-size: 12px; color: var(--muted); }
        .badge.warn { background: #fff3d6; color: #8a5a00; }

        /* Sessions */
        .section-label { font-size: 12px; font-weight: 700; color: var(--faint); text-transform: uppercase; letter-spacing: 0.4px; margin: 16px 0 4px; }
        .meeting .plan { font-size: 13px; color: var(--muted); white-space: pre-wrap; margin-top: 4px; }
        .mode-row { margin: 4px 0 14px; }

        /* Room plan checklist */
        .plan-list label { display: flex; gap: 8px; align-items: flex-start; margin-bottom: 6px; font-size: 14px; }
        .plan-list input { margin-top: 4px; }
        .plan-list .done { text-decoration: line-through; color: var(--muted); }

        /* Sign-in setup steps */
        .step-dots { display: flex; gap: 6px; margin-bottom: 14px; }
        .step-dots span { width: 28px; height: 4px; border-radius: 99px; background: var(--line); }
        .step-dots span.on { background: var(--blue); }

        @media (max-width: 560px) {
            .av-maker { grid-template-columns: 1fr; }
            .filters select { flex: 1; min-width: 0; }
        }
    </style>
</head>
<body>

    <div class="toast" id="toast"></div>

    <!-- Pop-up window (match, report, block, password). Filled in by openModal() -->
    <div class="modal-back hidden" id="modalBack" onclick="if (event.target === this) closeModal()">
        <div class="modal" id="modal" role="dialog" aria-modal="true"></div>
    </div>


    <!-- ==============================================================
         ABOUT PAGE: what AYXchange does (first thing visitors see)
         ============================================================== -->
    <div class="landing" id="landing">
        <header class="header">
            <div class="header-inner">
                <div class="logo-row" onclick="window.scrollTo(0, 0)">
                    <span class="logo-mark">A</span>
                    <span class="logo-text">AYXchange</span>
                </div>
                <div class="landing-actions" id="landingActions"></div>
            </div>
        </header>

        <main class="landing-main">
            <section class="hero">
                <h1>Find a mentor, a study partner, or someone to build with.</h1>
                <p>AYXchange connects students with mentors and with each other. Make your own avatar, share moments, connect, chat, and book a time to meet.</p>
                <div class="row" id="heroActions"></div>
            </section>

            <section class="landing-section">
                <h2>What you can do</h2>
                <div class="feature-grid">
                    <div class="feature">
                        <h3>Make your avatar</h3>
                        <p>Build a cute avatar that's all you: hair, eyes, smile, a hard hat or grad cap, and more.</p>
                    </div>
                    <div class="feature">
                        <h3>Share moments</h3>
                        <p>Ask a question, look for teammates, or share a win. React with 💚 👏 💡 ✨.</p>
                    </div>
                    <div class="feature">
                        <h3>Connect with anyone</h3>
                        <p>Browse by interest, skill, and free time, or type someone's member ID. When they accept, it's a match!</p>
                    </div>
                    <div class="feature">
                        <h3>Propose sessions</h3>
                        <p>Pick a day and time, video or in person, with a short plan. They accept or decline.</p>
                    </div>
                    <div class="feature">
                        <h3>Meet and take notes</h3>
                        <p>Use the room with your camera and mic, check off your plan, and save shared notes.</p>
                    </div>
                    <div class="feature">
                        <h3>Resume review + AI buddy</h3>
                        <p>Get an instant resume score, and quick answers about internships, interviews, and studying.</p>
                    </div>
                </div>
            </section>

            <section class="landing-section">
                <h2>How it works</h2>
                <ol class="steps">
                    <li><b>1. Join</b>Create an account, pick student or mentor, and make your avatar.</li>
                    <li><b>2. Connect</b>Find people who share your interests and free time, then send a request.</li>
                    <li><b>3. Talk</b>When they accept, message each other and propose a session.</li>
                    <li><b>4. Grow</b>Meet, save notes and goals, and share what you learned.</li>
                </ol>
            </section>

            <section class="landing-section">
                <h2>Who it's for</h2>
                <div class="who">
                    <div class="panel">
                        <h3>Students</h3>
                        <ul>
                            <li>Get advice from people already working in your field</li>
                            <li>Find classmates for projects, hackathons, and study groups</li>
                            <li>Get your resume reviewed before you apply</li>
                        </ul>
                    </div>
                    <div class="panel">
                        <h3>Mentors</h3>
                        <ul>
                            <li>Share what you know with students who want to learn</li>
                            <li>See a student's interests and resume before you meet</li>
                            <li>Accept only the sessions that fit your week</li>
                        </ul>
                    </div>
                </div>
            </section>
        </main>

        <footer class="landing-foot">AYXchange · Built at HackOHI/O 2026 for the Bridge Builder Challenge · Team A.Y.</footer>
    </div>


    <!-- ==============================================================
         SIGN IN / CREATE ACCOUNT
         ============================================================== -->
    <div class="auth hidden" id="auth">
        <div class="auth-box" id="authBox">
            <button class="back" onclick="showLanding()">← What is AYXchange?</button>
            <div class="logo-row">
                <span class="logo-mark">A</span>
                <span class="logo-text">AYXchange</span>
            </div>

            <div class="panel auth-panel">

                <!-- Shows if the Supabase keys are missing -->
                <div class="setup-warning hidden" id="setupWarning"></div>

                <!-- ===== SIGN IN or CREATE ACCOUNT ===== -->
                <div id="viewLogin">
                    <div class="segmented">
                        <button id="tabSignIn" class="on" onclick="setLoginTab('in')">Sign in</button>
                        <button id="tabSignUp" onclick="setLoginTab('up')">Create account</button>
                    </div>
                    <form onsubmit="submitLogin(event)">
                        <label class="field">
                            <span>Email</span>
                            <input id="emailInput" type="email" placeholder="you@example.com" autocomplete="email">
                        </label>
                        <label class="field">
                            <span>Password</span>
                            <input id="passwordInput" type="password" autocomplete="current-password" placeholder="At least 8 characters">
                        </label>
                        <p class="error" id="loginError"></p>
                        <button class="btn btn-primary btn-block" id="loginBtn">Sign in</button>
                    </form>
                    <button class="link-btn" id="forgotLink" onclick="authMode('forgot')">Forgot password?</button>
                </div>

                <!-- ===== CONFIRM YOUR EMAIL ===== -->
                <div id="viewCheck" class="hidden">
                    <h1>Check your email</h1>
                    <p class="muted">We sent a confirmation link to <b id="checkEmail"></b>. Open it, then come back and sign in.</p>
                    <button class="btn btn-secondary btn-block" onclick="authMode('login')">Back to sign in</button>
                </div>

                <!-- ===== FORGOT PASSWORD ===== -->
                <div id="viewForgot" class="hidden">
                    <h1>Reset your password</h1>
                    <p class="muted">We'll email you a link to choose a new password.</p>
                    <form onsubmit="sendReset(event)">
                        <label class="field">
                            <span>Email</span>
                            <input id="resetEmail" type="email" autocomplete="email">
                        </label>
                        <p class="error" id="resetError"></p>
                        <button class="btn btn-primary btn-block" id="resetBtn">Send reset link</button>
                    </form>
                    <button class="link-btn" onclick="authMode('login')">Back to sign in</button>
                </div>

                <!-- ===== CHOOSE A NEW PASSWORD (after the reset link) ===== -->
                <div id="viewNewPass" class="hidden">
                    <h1>Choose a new password</h1>
                    <form onsubmit="saveNewPassword(event)">
                        <label class="field">
                            <span>New password</span>
                            <input id="newPassInput" type="password" autocomplete="new-password" placeholder="At least 8 characters">
                        </label>
                        <p class="error" id="newPassError"></p>
                        <button class="btn btn-primary btn-block" id="newPassBtn">Save password</button>
                    </form>
                </div>

                <!-- ===== FIRST TIME, STEP 1: ABOUT YOU ===== -->
                <div id="viewSetup" class="hidden">
                    <div class="step-dots"><span class="on"></span><span></span></div>
                    <h1>Tell us about you</h1>
                    <p class="muted">for <b id="setupEmail"></b></p>

                    <div class="segmented">
                        <button id="roleStudent" class="on" onclick="setRole('student')">Student</button>
                        <button id="roleMentor" onclick="setRole('mentor')">Mentor</button>
                    </div>

                    <label class="field">
                        <span>Full name</span>
                        <input id="nameInput" placeholder="Your name" autocomplete="name" maxlength="80">
                    </label>

                    <!-- Students: major -->
                    <div id="studentFields">
                        <label class="field">
                            <span>Major</span>
                            <select id="majorSelect" onchange="checkOtherMajor()"></select>
                        </label>
                        <label class="field hidden" id="otherMajorField">
                            <span>Your major</span>
                            <input id="otherMajorInput" placeholder="Type your major" maxlength="100">
                        </label>
                    </div>

                    <!-- Mentors: job -->
                    <div id="mentorFields" class="hidden">
                        <label class="field">
                            <span>Job title</span>
                            <input id="titleInput" placeholder="Software Engineer" maxlength="100">
                        </label>
                        <label class="field">
                            <span>Company or organization</span>
                            <input id="companyInput" placeholder="Your company or organization" maxlength="100">
                        </label>
                    </div>

                    <div class="field-block">
                        <span class="field-label">Topics you care about</span>
                        <div id="setupInterests"></div>
                    </div>
                    <div class="field-block">
                        <span class="field-label">You can help with</span>
                        <div id="setupSkills"></div>
                    </div>
                    <div class="field-block">
                        <span class="field-label">When you're free</span>
                        <div id="setupFree"></div>
                    </div>

                    <p class="error" id="setupError"></p>
                    <button class="btn btn-primary btn-block" onclick="setupNext()">Next: make your avatar →</button>
                </div>

                <!-- ===== FIRST TIME, STEP 2: MAKE YOUR AVATAR ===== -->
                <div id="viewAvatar" class="hidden">
                    <div class="step-dots"><span class="on"></span><span class="on"></span></div>
                    <h1>Make your avatar</h1>
                    <p class="muted">This is how people see you. You can change it any time.</p>
                    <div id="setupAvatar"></div>
                    <p class="error" id="avatarError"></p>
                    <div style="display:flex; gap:8px">
                        <button class="btn btn-secondary" onclick="authMode('setup')">← Back</button>
                        <button class="btn btn-primary" style="flex:1" id="createBtn" onclick="createAccount(this)">Start using AYXchange</button>
                    </div>
                </div>

            </div>
            <p class="fine">Accounts are stored securely with Supabase.</p>
        </div>
    </div>


    <!-- ==============================================================
         THE APP (shows after sign in)
         ============================================================== -->
    <div id="app" class="hidden">

        <div class="demo-bar hidden" id="demoBar">
            Demo mode · sample people · nothing is saved ·
            <button onclick="exitDemo()">Exit demo</button>
        </div>

        <!-- HEADER -->
        <header class="header">
            <div class="header-inner">
                <div class="logo-row" onclick="go('home')">
                    <span class="logo-mark">A</span>
                    <span class="logo-text">AYXchange</span>
                </div>

                <nav class="tabs">
                    <button data-screen="home" class="on">Home</button>
                    <button data-screen="people">People</button>
                    <button data-screen="messages">Messages</button>
                    <button data-screen="sessions">Sessions</button>
                    <button data-screen="room">Room</button>
                    <button data-screen="notes">Notes</button>
                </nav>

                <div class="me-spot">
                    <button class="avatar-btn" id="headerAvatar" onclick="toggleMenu()" aria-label="Your account"></button>
                    <div class="menu hidden" id="menu">
                        <div class="menu-head">
                            <div id="menuAvatar"></div>
                            <div><b id="menuName"></b><span class="small muted" id="menuInfo"></span></div>
                        </div>
                        <button class="menu-item" onclick="go('profile')">Profile &amp; settings</button>
                        <button class="menu-item" onclick="showLanding()">About AYXchange</button>
                        <button class="menu-item danger" onclick="signOut()">Sign out</button>
                    </div>
                </div>
            </div>
        </header>


        <main class="page">

            <!-- ==========================================================
                 HOME: moments feed, requests, connections
                 ========================================================== -->
            <section class="screen on" id="home">
                <div class="page-head">
                    <h1 id="homeTitle"></h1>
                    <p class="muted" id="homeSub"></p>
                </div>

                <div class="two-col">
                    <div class="col-main">
                        <!-- Share a moment -->
                        <div class="panel composer">
                            <div class="composer-row">
                                <div id="composerAvatar"></div>
                                <textarea id="postInput" rows="3" maxlength="500" oninput="updateCounter()"
                                          placeholder="Ask a question, share a win, or look for teammates…"></textarea>
                            </div>
                            <div class="composer-foot">
                                <span class="counter" id="postCounter">0/500 · Everyone on AYXchange can see this.</span>
                                <button class="btn btn-primary" onclick="createMoment(this)">Share</button>
                            </div>
                        </div>

                        <!-- Moments -->
                        <div class="panel" id="feed"></div>
                    </div>

                    <aside class="col-side">
                        <div class="panel side-card" id="requestsCard"></div>
                        <div class="panel side-card" id="connectionsCard"></div>
                        <div class="panel side-card">
                            <h3>AI study buddy</h3>
                            <p class="small muted" style="margin-bottom: 12px">Quick help with resumes, interviews, internships, studying, and more.</p>
                            <button class="btn btn-secondary btn-sm" onclick="openChat('ai')">Open chat</button>
                        </div>
                    </aside>
                </div>
            </section>


            <!-- ==========================================================
                 PEOPLE (find students and mentors)
                 ========================================================== -->
            <section class="screen" id="people">
                <div class="page-head">
                    <h1>People</h1>
                    <p class="muted">Find students and mentors who share your interests, then connect.</p>
                </div>

                <!-- Find someone by their member ID -->
                <div class="panel find-box">
                    <h3>Find someone by member ID</h3>
                    <p class="small muted">Ask them for their ID. Yours is <span class="id-chip" id="myIdPeople"></span>
                        <button class="btn btn-ghost btn-sm" onclick="copyMyId()">Copy</button></p>
                    <form class="find-row" onsubmit="findById(event)">
                        <input id="findIdInput" placeholder="AYX-000000" autocomplete="off">
                        <button class="btn btn-primary">Find</button>
                    </form>
                    <div class="find-result" id="findResult"></div>
                </div>

                <h2 class="browse-title">Browse everyone</h2>
                <div class="people-bar">
                    <input id="peopleSearch" type="search" placeholder="Search by name, ID, major, company, or interest" oninput="renderPeople()">
                    <div class="filter" id="peopleFilter">
                        <button data-f="all" class="on" onclick="setPeopleFilter('all')">Everyone</button>
                        <button data-f="student" onclick="setPeopleFilter('student')">Students</button>
                        <button data-f="mentor" onclick="setPeopleFilter('mentor')">Mentors</button>
                    </div>
                </div>
                <div class="filters">
                    <select id="interestFilter" onchange="renderPeople()" aria-label="Filter by topic"></select>
                    <select id="skillFilter" onchange="renderPeople()" aria-label="Filter by skill"></select>
                    <select id="freeFilter" onchange="renderPeople()" aria-label="Filter by free time"></select>
                    <button class="btn btn-ghost btn-sm" onclick="clearPeopleFilters()">Clear filters</button>
                </div>

                <div class="people-grid" id="peopleGrid"></div>
            </section>


            <!-- ==========================================================
                 MESSAGES
                 ========================================================== -->
            <section class="screen" id="messages">
                <div class="page-head">
                    <h1>Messages</h1>
                    <p class="muted">You can message someone once you're connected. The AI study buddy is always here.</p>
                </div>

                <div class="panel chat">
                    <div class="chat-list" id="chatList"></div>
                    <div class="chat-main">
                        <div class="chat-head" id="chatHead"></div>
                        <div class="chat-body" id="chatBody"></div>
                        <div class="chips" id="chips"></div>
                        <form class="chat-compose" id="chatForm" onsubmit="sendMessage(event)">
                            <input id="chatInput" placeholder="Write a message" autocomplete="off" maxlength="2000">
                            <button class="btn btn-primary">Send</button>
                        </form>
                    </div>
                </div>
            </section>


            <!-- ==========================================================
                 SESSIONS (calendar + proposals)
                 ========================================================== -->
            <section class="screen" id="sessions">
                <div class="page-head">
                    <h1>Sessions</h1>
                    <p class="muted">Propose a time to someone you're connected with. They accept or decline.</p>
                </div>

                <div class="two-col">
                    <div class="panel cal">
                        <div class="cal-head">
                            <button class="icon-btn" onclick="moveMonth(-1)" aria-label="Previous month">‹</button>
                            <h2 id="calTitle"></h2>
                            <button class="icon-btn" onclick="moveMonth(1)" aria-label="Next month">›</button>
                        </div>
                        <div class="cal-grid" id="calGrid"></div>
                        <div class="book" id="bookArea"></div>
                    </div>

                    <aside class="panel side-card" id="upcoming"></aside>
                </div>
            </section>


            <!-- ==========================================================
                 ROOM (real camera + mic)
                 ========================================================== -->
            <section class="screen" id="room">
                <div class="page-head">
                    <h1>Room</h1>
                    <p class="muted" id="roomSub"></p>
                </div>

                <!-- Shown when no session is open -->
                <div class="panel" id="roomEmpty"></div>

                <!-- Shown during a session -->
                <div class="room-grid hidden" id="roomLive">
                    <div>
                        <div class="tiles">
                            <div class="tile">
                                <video id="myVideo" autoplay playsinline muted class="hidden"></video>
                                <div id="myTileAvatar"></div>
                                <span class="tile-status" id="myStatus">Mic off</span>
                                <span class="tile-name">You</span>
                            </div>
                            <div class="tile">
                                <div id="otherTileAvatar"></div>
                                <span class="tile-wait" id="otherWait"></span>
                                <span class="tile-name" id="otherName"></span>
                            </div>
                        </div>

                        <div class="meter-row">
                            <span class="small muted">Mic</span>
                            <div class="meter"><div id="micLevel"></div></div>
                        </div>

                        <div class="controls">
                            <button class="btn btn-secondary" id="camBtn" onclick="toggleCamera()">Turn on camera</button>
                            <button class="btn btn-secondary" id="micBtn" onclick="toggleMic()">Turn on mic</button>
                            <button class="btn btn-danger" onclick="leaveRoom()">Leave and save</button>
                        </div>
                        <p class="small muted room-note">Your camera and mic really turn on. Seeing the other person needs a video server, which this demo doesn't have yet.</p>

                        <div class="panel side-card" style="margin-top:16px" id="planCard"></div>
                    </div>

                    <div class="panel side-card">
                        <h3>Shared notes</h3>
                        <p class="small muted" style="margin-bottom: 12px">Both of you can see these.</p>
                        <label class="field">
                            <span>Goal</span>
                            <input id="goalInput" maxlength="200" placeholder="Apply to 3 internships by Friday">
                        </label>
