        /* ==============================================================
           SESSIONS (calendar + proposals)
             You propose a time → they accept or decline.
             The person who proposed can cancel before it's answered.
             Either person can cancel an accepted session.
           ============================================================== */
        const today = new Date();
        let viewYear = today.getFullYear();
        let viewMonth = today.getMonth();
        let pickedDate = null;      // 'YYYY-MM-DD'
        let pickedTime = null;      // '3:00 PM'
        let bookWith = null;        // person id
        let bookMode = 'video';
        let bookLocation = '';
        let bookPlan = null;        // null = use the Warm Start plan

        const TIMES = [];
        for (let h = 9; h <= 20; h++) {
            ['00', '30'].forEach(min => {
                if (h === 20 && min === '30') return;
                const hour = h > 12 ? h - 12 : h;
                TIMES.push(hour + ':' + min + (h >= 12 ? ' PM' : ' AM'));
            });
        }

        // '2026-10-25' + '3:30 PM' → a real date
        function toDate(day, time) {
            const [y, m, d] = day.split('-').map(Number);
            const [hm, ap] = time.split(' ');
            let [h, min] = hm.split(':').map(Number);
            if (ap === 'PM' && h !== 12) h += 12;
            if (ap === 'AM' && h === 12) h = 0;
            return new Date(y, m - 1, d, h, min);
        }

        function moveMonth(step) {
            viewMonth += step;
            if (viewMonth < 0) { viewMonth = 11; viewYear--; }
            if (viewMonth > 11) { viewMonth = 0; viewYear++; }
            renderSessions();
        }

        function meetingConnection(m) { return state.connections.find(c => c.id === m.connection_id); }
        function otherPerson(m) {
            const c = meetingConnection(m);
            return c ? users()[otherSide(c)] : null;
        }
        function myMeetings() {
            return state.meetings.filter(m => { const o = otherPerson(m); return o && !hidden(o.id); });
        }
        const isOpen = m => m.status === 'proposed' || m.status === 'accepted';

        // "Warm Start" plan, based on what you have in common
        function warmStart(other) {
            const common = shared(me(), other, 'interests');
            const topic = common[0] || (other && other.interests && other.interests[0]) || 'your goals';
            return '1. Quick intros: what you\'re working on\n2. Talk about ' + topic + '\n3. Pick one thing to try this week';
        }

        function scheduleWith(personId) {
            bookWith = personId;
            bookPlan = null;
            go('sessions');
        }

        function pickDate(key) { pickedDate = key; pickedTime = null; renderSessions(); }
        function pickTime(t) { pickedTime = t; renderSessions(); }
        function pickWith(id) { bookWith = id; renderSessions(); }
        function pickMode(mode) { bookMode = mode; renderSessions(); }

        function renderSessions() {
            const mine = myMeetings();
            const open = mine.filter(isOpen);
            const busyDays = new Set(open.map(m => dateKey(new Date(m.starts_at))));

            $('calTitle').textContent = new Date(viewYear, viewMonth, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

            let grid = ['S', 'M', 'T', 'W', 'T', 'F', 'S'].map(d => '<div class="cal-dow">' + d + '</div>').join('');
            const firstDay = new Date(viewYear, viewMonth, 1).getDay();
            const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
            const todayKey = dateKey(new Date());

            for (let i = 0; i < firstDay; i++) grid += '<div></div>';
            for (let d = 1; d <= daysInMonth; d++) {
                const key = dateKey(new Date(viewYear, viewMonth, d));
                let cls = 'day';
                if (key === todayKey) cls += ' today';
                if (key === pickedDate) cls += ' picked';
                grid += '<button class="' + cls + '"' + (key < todayKey ? ' disabled' : '') + ' onclick="pickDate(\'' + key + '\')">' + d +
                    (busyDays.has(key) ? '<span class="dot"></span>' : '') + '</button>';
            }
            $('calGrid').innerHTML = grid;

            // ----- Booking area -----
            const people = myConnections();
            if (!bookWith || !people.find(p => p.id === bookWith)) bookWith = people.length ? people[0].id : null;
            const other = users()[bookWith];
            let book = '';
            if (!pickedDate) {
                book = '<p class="muted small">Choose a day to see open times.</p>';
            } else if (people.length === 0) {
                book = '<h3>' + niceDate(pickedDate) + '</h3><p class="muted small">You need a connection before you can propose a session. ' +
                    'Find someone on the <a href="#" onclick="go(\'people\'); return false;">People</a> page.</p>';
            } else {
                const soon = Date.now() + 5 * 60e3;
                const taken = new Set(open.map(m => new Date(m.starts_at).getTime()));
                book = '<h3>' + niceDate(pickedDate) + '</h3><div class="times">' +
                    TIMES.map(t => {
                        const when = toDate(pickedDate, t).getTime();
                        const off = when < soon || taken.has(when);
                        return '<button class="time-btn' + (t === pickedTime ? ' picked' : '') + '"' + (off ? ' disabled' : '') +
                            ' onclick="pickTime(\'' + t + '\')">' + t + '</button>';
                    }).join('') + '</div>' +
                    '<label class="field"><span>Meet with</span><select onchange="pickWith(this.value)">' +
                    people.map(p => '<option value="' + p.id + '"' + (p.id === bookWith ? ' selected' : '') + '>' + esc(p.name) + '</option>').join('') +
                    '</select></label>' +
                    '<span class="field-label">How</span><div class="segmented mode-row">' +
                    '<button class="' + (bookMode === 'video' ? 'on' : '') + '" onclick="pickMode(\'video\')">Video</button>' +
                    '<button class="' + (bookMode === 'in_person' ? 'on' : '') + '" onclick="pickMode(\'in_person\')">In person</button></div>' +
                    (bookMode === 'in_person'
                        ? '<label class="field"><span>Where</span><input maxlength="160" placeholder="Thompson Library, 2nd floor" value="' + esc(bookLocation) + '" oninput="bookLocation = this.value"></label>'
                        : '') +
                    '<label class="field"><span>Plan (they\'ll see this)</span><textarea rows="3" maxlength="300" oninput="bookPlan = this.value">' +
                    esc(bookPlan ?? warmStart(other)) + '</textarea></label>' +
                    '<button class="btn btn-primary" onclick="sendProposal(this)">Send proposal' + (pickedTime ? ' for ' + pickedTime : '') + '</button>';
            }
            $('bookArea').innerHTML = book;

            // ----- Lists -----
            const now = Date.now();
            const byTime = (a, b) => new Date(a.starts_at) - new Date(b.starts_at);
            const future = m => new Date(m.starts_at).getTime() > now;
            const needs = mine.filter(m => m.status === 'proposed' && m.proposed_by !== myId() && future(m)).sort(byTime);
            const waiting = mine.filter(m => m.status === 'proposed' && m.proposed_by === myId() && future(m)).sort(byTime);
            const coming = mine.filter(m => m.status === 'accepted' && new Date(m.starts_at).getTime() > now - 2 * 3600e3).sort(byTime);

            const row = (m, buttons) => {
                const o = otherPerson(m);
                return '<div class="meeting"><div class="when">' + niceWhen(m.starts_at) + '</div>' +
                    '<div class="small muted">with ' + esc(o ? o.name : 'someone') + ' · ' +
                    (m.mode === 'video' ? 'Video' : 'In person at ' + esc(m.location)) + '</div>' +
                    (m.note ? '<div class="plan">' + esc(m.note) + '</div>' : '') +
                    '<div class="row">' + buttons + '</div></div>';
            };

            let up = '<h3>Your sessions</h3>';
            if (!needs.length && !waiting.length && !coming.length) up += '<p class="small muted">Nothing planned yet. Pick a day to propose one.</p>';
            if (needs.length) {
                up += '<div class="section-label">Needs your answer</div>' + needs.map(m => row(m,
                    '<button class="btn btn-primary btn-sm" onclick="setMeeting(\'' + m.id + '\', \'accepted\')">Accept</button>' +
                    '<button class="btn btn-ghost btn-sm" onclick="setMeeting(\'' + m.id + '\', \'declined\')">Decline</button>')).join('');
            }
            if (coming.length) {
                up += '<div class="section-label">Coming up</div>' + coming.map(m => row(m,
                    '<button class="btn btn-primary btn-sm" onclick="joinRoom(\'' + m.id + '\')">Join room</button>' +
                    '<button class="btn btn-ghost btn-sm" onclick="setMeeting(\'' + m.id + '\', \'cancelled\')">Cancel</button>')).join('');
            }
            if (waiting.length) {
                up += '<div class="section-label">Waiting for them</div>' + waiting.map(m => row(m,
                    '<span class="badge warn">Proposed</span>' +
                    '<button class="btn btn-ghost btn-sm" onclick="setMeeting(\'' + m.id + '\', \'cancelled\')">Cancel</button>')).join('');
            }
            $('upcoming').innerHTML = up;
        }

        async function sendProposal(button) {
            if (!pickedTime) { toast('Pick a time first'); return; }
            if (!bookWith) { toast('Pick who to meet with'); return; }
            const where = bookLocation.trim();
            if (bookMode === 'in_person' && !where) { toast('Add where you\'ll meet'); return; }
            const when = toDate(pickedDate, pickedTime);
            if (when.getTime() <= Date.now()) { toast('That time already passed. Pick a later one.'); return; }
            const conn = connectionWith(bookWith);
            const plan = (bookPlan ?? warmStart(users()[bookWith])).trim();

            await busy(button, 'Sending…', async () => {
                const { error } = await db.propose({
                    connection_id: conn.id,
                    starts_at: when.toISOString(),
                    mode: bookMode,
                    location: bookMode === 'in_person' ? where : null,
                    note: plan || null
                });
                if (error) { toast(friendly(error)); return; }
                toast('Proposal sent to ' + users()[bookWith].name.split(' ')[0]);
                pickedTime = null;
                bookPlan = null;
                await refresh();
            });
        }

        async function setMeeting(id, status) {
            const { error } = await db.setMeetingStatus(id, status);
            if (error) { toast(friendly(error)); return; }
            toast({ accepted: 'Session accepted 🎉', declined: 'Session declined', cancelled: 'Session cancelled' }[status]);
            if (status === 'cancelled' && roomMeeting === id) roomMeeting = null;
            refresh();
        }


        /* ==============================================================
           ROOM (real camera + mic)
           ============================================================== */
        let roomMeeting = null;
        let camStream = null;
        let micStream = null;
        let audioCtx = null;
        let meterLoop = null;
        const planChecks = {};      // meeting id → which plan steps are checked

        function joinRoom(id) {
            roomMeeting = id;
            go('room');
            renderRoom();
            const n = state.notes[id] || {};
            $('goalInput').value = n.goal || '';
            $('notesInput').value = n.notes || '';
        }

        function renderRoom() {
            const m = state.meetings.find(x => x.id === roomMeeting && x.status === 'accepted');
            if (!m) {
                $('roomLive').classList.add('hidden');
                $('roomEmpty').classList.remove('hidden');
                $('roomSub').textContent = 'Join a session from the Sessions page.';
                $('roomEmpty').innerHTML = '<div class="empty-state"><h3>No session open</h3><p>When someone accepts your session, tap "Join room".</p>' +
                    '<p style="margin-top:14px"><button class="btn btn-secondary" onclick="go(\'sessions\')">Go to Sessions</button></p></div>';
                return;
