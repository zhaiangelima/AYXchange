        /* ==============================================================
           RESUME REVIEW
           Reads the text in your PDF, then checks it the way a recruiter
           would: length, contact info, sections, strong bullet points,
           numbers, and weak phrases. Gives a score out of 100 + fixes.
           ============================================================== */
        const ACTION_VERBS = ['achieved', 'analyzed', 'assembled', 'automated', 'built', 'calculated', 'collaborated', 'conducted',
            'configured', 'coordinated', 'created', 'debugged', 'decreased', 'delivered', 'designed', 'developed', 'documented',
            'drafted', 'engineered', 'established', 'evaluated', 'expanded', 'explained', 'fabricated', 'facilitated', 'founded',
            'generated', 'graded', 'guided', 'identified', 'implemented', 'improved', 'increased', 'initiated', 'installed',
            'integrated', 'investigated', 'launched', 'led', 'maintained', 'managed', 'measured', 'mentored', 'modeled',
            'optimized', 'organized', 'planned', 'presented', 'programmed', 'prototyped', 'published', 'raised', 'redesigned',
            'reduced', 'refactored', 'repaired', 'researched', 'resolved', 'reviewed', 'simulated', 'soldered', 'solved',
            'streamlined', 'supervised', 'taught', 'tested', 'trained', 'tutored', 'validated', 'wrote', 'compared', 'served',
            'processed', 'scheduled', 'monitored', 'assisted', 'prepared', 'handled', 'operated', 'performed', 'deployed', 'ran'];

        const WEAK_PHRASES = ['responsible for', 'duties included', 'helped with', 'helped to', 'worked on', 'in charge of',
            'tasks included', 'various', 'etc', 'team player', 'hard worker', 'detail oriented', 'detail-oriented'];

        const SECTIONS = {
            Education:  ['education', 'academics'],
            Experience: ['experience', 'work experience', 'employment', 'work history', 'professional experience', 'leadership', 'involvement'],
            Projects:   ['projects', 'project experience', 'technical projects', 'personal projects', 'academic projects'],
            Skills:     ['skills', 'technical skills', 'skills & interests', 'skills and interests', 'tools', 'languages']
        };

        // Get the lines of text out of a PDF
        async function pdfLines(buffer) {
            if (!window.pdfjsLib) throw new Error('The PDF reader did not load. Check your internet and refresh.');
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
            const pdf = await pdfjsLib.getDocument({ data: buffer }).promise;
            const lines = [];
            for (let n = 1; n <= pdf.numPages; n++) {
                const page = await pdf.getPage(n);
                const content = await page.getTextContent();
                let line = '', lastY = null, lastEnd = null;
                content.items.forEach(item => {
                    const x = item.transform[4], y = item.transform[5];
                    if (lastY !== null && Math.abs(y - lastY) > 3) { lines.push(line); line = ''; lastEnd = null; }
                    if (lastEnd !== null && x - lastEnd > 1.5 && !line.endsWith(' ')) line += ' ';
                    line += item.str;
                    lastY = y;
                    lastEnd = x + item.width;
                });
                lines.push(line);
            }
            return { pages: pdf.numPages, lines: lines.map(l => l.replace(/\s+/g, ' ').trim()).filter(Boolean) };
        }

        function shorten(text, n) { return text.length > n ? text.slice(0, n - 1) + '…' : text; }

        // Look at the resume text and build the review
        function checkResume(pages, lines) {
            const all = lines.join('\n');
            const lower = all.toLowerCase();
            const words = all.split(/\s+/).filter(Boolean).length;
            const good = [], fix = [];
            let score = 0;

            if (words < 40) {
                return { score: 0, pages, words, good, fix: [{ text: 'I couldn\'t read much text. If your resume is a scanned picture, export it again from Word or Google Docs as a PDF.' }] };
            }

            // 1. Length (10)
            if (pages === 1) { score += 10; good.push({ text: 'It fits on one page.' }); }
            else if (pages === 2) { score += 5; fix.push({ text: 'It\'s 2 pages. Most students should keep it to one page.' }); }
            else fix.push({ text: 'It\'s ' + pages + ' pages. Cut it down to one page.' });
            if (words < 200) fix.push({ text: 'It\'s short (' + words + ' words). Add more detail about your projects and experience.' });
            if (words > 800) fix.push({ text: 'It\'s wordy (' + words + ' words). Shorten bullets so it\'s easy to skim.' });

            // 2. Contact info (20)
            if (/[\w.+-]+@[\w-]+\.[\w.]+/.test(all)) { score += 10; good.push({ text: 'Has an email address.' }); }
            else fix.push({ text: 'Add your email address at the top.' });
            if (/(\+?1[\s.-]?)?\(?\d{3}\)?[\s.-]?\d{3}[\s.-]?\d{4}/.test(all)) score += 5;
            else fix.push({ text: 'Add a phone number.' });
            if (/linkedin/i.test(all)) score += 5;
            else fix.push({ text: 'Add your LinkedIn link so recruiters can find you.' });
            if (/github|portfolio|\.dev\b|\.io\b/i.test(all)) good.push({ text: 'Links to GitHub or a portfolio.' });

            // 3. Sections (40)
            const isHeading = (line, names) => {
                const l = line.toLowerCase().replace(/[^a-z& ]/g, '').trim();
                return line.length <= 40 && names.some(n => l === n || l.startsWith(n + ' '));
            };
            const found = [];
            for (const name in SECTIONS) {
                if (lines.some(l => isHeading(l, SECTIONS[name]))) { score += 10; found.push(name); }
                else fix.push({ text: 'Add a clear "' + name + '" section heading.' });
            }
            if (found.length) good.push({ text: 'Has these sections: ' + found.join(', ') + '.' });

            // 4. Bullet points
            const bulletChars = /^[•●▪◦‣∙·\-–*➢►■□o]\s+/;
            let bullets = lines.filter(l => bulletChars.test(l)).map(l => l.replace(bulletChars, ''));
            if (bullets.length < 3) {
                bullets = lines.filter(l => l.split(' ').length >= 7 && !/@|linkedin|github/i.test(l));
            }

            if (bullets.length) {
                const firstWord = b => b.toLowerCase().split(/\s+/)[0].replace(/[^a-z]/g, '');
                const strong = bullets.filter(b => ACTION_VERBS.includes(firstWord(b)));
                const share = strong.length / bullets.length;

                // Action verbs (15)
                if (share >= 0.6) { score += 15; good.push({ text: 'Most bullets start with a strong action verb.' }); }
                else {
                    score += Math.round(share * 15);
                    const weak = bullets.find(b => !ACTION_VERBS.includes(firstWord(b)));
                    fix.push({ text: 'Start each bullet with an action verb (Built, Designed, Led, Tested). Only ' + strong.length + ' of ' + bullets.length + ' do.', quote: weak });
                }

                // Numbers (10)
                const withNumbers = bullets.filter(b => /\d|%|\$/.test(b));
                if (withNumbers.length / bullets.length >= 0.3) { score += 10; good.push({ text: 'Uses numbers to show results.' }); }
                else {
                    score += Math.round((withNumbers.length / bullets.length) * 30);
                    const noNum = bullets.find(b => !/\d|%|\$/.test(b));
                    fix.push({ text: 'Add numbers to show impact (how many, how much, how fast). Example: "Tested 12 battery cells…"', quote: noNum });
                }

                // Long bullets
                const long = bullets.find(b => b.split(' ').length > 30);
                if (long) fix.push({ text: 'Some bullets are very long. Keep each one to 1–2 lines.', quote: long });

                // First person
                const iLine = bullets.find(b => /\b(i|my|me)\b/i.test(b));
                if (iLine) fix.push({ text: 'Don\'t use "I", "me", or "my" in bullets. Start with the verb instead.', quote: iLine });
            } else {
                fix.push({ text: 'Use bullet points under each job or project so it\'s easy to skim.' });
            }

            // 5. Weak phrases (5)
            const weakFound = WEAK_PHRASES.filter(p => new RegExp('\\b' + p.replace(/[-]/g, '\\-') + '\\b').test(lower));
            if (weakFound.length === 0) { score += 5; good.push({ text: 'No weak filler phrases.' }); }
            else {
                const line = lines.find(l => weakFound.some(p => l.toLowerCase().includes(p)));
                fix.push({ text: 'Replace weak phrases like "' + weakFound.slice(0, 3).join('", "') + '" with what you actually did.', quote: line && line.replace(bulletChars, '') });
            }

            // Extra tips (no points)
            if (!/gpa/i.test(all)) fix.push({ text: 'Think about adding your GPA if it\'s 3.0 or higher.' });
            if (!/(19|20)\d{2}/.test(all)) fix.push({ text: 'Add dates (month and year) for your school and experience.' });

            return { score: Math.min(100, score), pages, words, good, fix };
        }

        async function reviewPdf(buffer) {
            try {
                const { pages, lines } = await pdfLines(buffer);
                return checkResume(pages, lines);
            } catch (e) {
                return { error: e.message || 'Could not read that PDF.' };
            }
        }

        function scoreLabel(score) {
            return score >= 80 ? 'Strong' : score >= 60 ? 'Good start' : 'Needs work';
        }

