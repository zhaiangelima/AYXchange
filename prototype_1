            const chips = key => AV[key].map(v =>
                '<button type="button" class="chip' + (a[key] === v ? ' on' : '') + '"' +
                ' onclick="avSet(\'' + boxId + '\', \'' + key + '\', \'' + v + '\')">' + v[0].toUpperCase() + v.slice(1) + '</button>').join('');
            const row = (key, html) => '<div class="av-row"><div class="lab">' + AV_LABELS[key] + '</div><div class="av-opts">' + html + '</div></div>';

            $(boxId).innerHTML =
                '<div class="av-maker">' +
                    '<div class="av-preview">' +
                        '<div class="avatar xl' + (wiggle ? ' av-wiggle' : '') + '">' + avatarSvg(a) + '</div>' +
                        '<button type="button" class="btn btn-secondary btn-sm" onclick="avRandom(\'' + boxId + '\')">🎲 Surprise me</button>' +
                    '</div>' +
                    '<div>' +
                        row('skin', swatches('skin')) + row('hair', chips('hair')) + row('hairColor', swatches('hairColor')) +
                        row('eyes', chips('eyes')) + row('mouth', chips('mouth')) + row('extra', chips('extra')) + row('bg', swatches('bg')) +
                        '<label class="small muted" style="display:flex; gap:8px; align-items:center">' +
                        '<input type="checkbox"' + (a.blush ? ' checked' : '') + ' onchange="avSet(\'' + boxId + '\', \'blush\', this.checked)"> Rosy cheeks</label>' +
                    '</div>' +
                '</div>';
        }

        function avSet(boxId, key, value) { avatarMakers[boxId][key] = value; drawAvatarMaker(boxId, true); }
