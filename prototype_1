        async function submitLogin(event) {
            event.preventDefault();
            const email = $('emailInput').value.trim().toLowerCase();
            const password = $('passwordInput').value;
            const err = $('loginError');
            if (!sb) { err.textContent = 'Accounts aren\'t connected yet. Try the demo instead.'; return; }
            if (!validEmail(email)) { err.textContent = 'Enter a valid email address.'; return; }
            if (password.length < 8) { err.textContent = 'Passwords are at least 8 characters.'; return; }

            await busy($('loginBtn'), loginTab === 'in' ? 'Signing in…' : 'Creating…', async () => {
                if (loginTab === 'in') {
                    const { data, error } = await sb.auth.signInWithPassword({ email, password });
                    if (error) { err.textContent = friendly(error); return; }
                    await openApp(data.user);
                } else {
                    const { data, error } = await sb.auth.signUp({ email, password, options: { emailRedirectTo: hereUrl() } });
                    if (error) { err.textContent = friendly(error); return; }
                    // Supabase hides whether an email is taken: no identities means it already exists
                    if (data.user && data.user.identities && data.user.identities.length === 0) {
                        err.textContent = 'This email already has an account. Sign in instead.';
                        return;
                    }
                    if (data.session) { await openApp(data.user); return; }
                    $('checkEmail').textContent = email;
                    authMode('check');
                }
            });
        }

