        function showReview(r) {
            if (!r) { $('resumeReview').innerHTML = ''; return; }
            if (r.error) {
                $('resumeReview').innerHTML = '<div class="review"><p class="small" style="color:var(--danger)">' + esc(r.error) + '</p></div>';
                return;
            }
            const item = x => '<li>' + esc(x.text) + (x.quote ? '<span class="quote">"' + esc(shorten(x.quote, 110)) + '"</span>' : '') + '</li>';
            $('resumeReview').innerHTML =
                '<div class="review">' +
                    '<div class="score-row"><span class="score">' + r.score + '/100</span><b>' + scoreLabel(r.score) + '</b>' +
                    '<span class="small muted">' + r.pages + ' page' + (r.pages > 1 ? 's' : '') + ' · ' + r.words + ' words</span></div>' +
                    '<div class="score-bar"><div style="width:' + r.score + '%"></div></div>' +
                    (r.good.length ? '<h4>What\'s working</h4><ul class="good">' + r.good.map(item).join('') + '</ul>' : '') +
                    (r.fix.length ? '<h4>What to fix</h4><ul class="fix">' + r.fix.map(item).join('') + '</ul>' : '<p class="small muted" style="margin-top:10px">Nothing big to fix. Ask a mentor for a final look!</p>') +
                '</div>';
        }

        // For the AI study buddy chat
        function wantsResumeReview(text) {
            const t = text.toLowerCase();
            return /\b(resume|cv)\b/.test(t) && /\b(review|check|look at|look over|feedback|score|rate|grade|read|improve)\b/.test(t) && !/\bhow\b.*\bwrite\b/.test(t);
        }

        async function resumeReviewForChat() {
            const r = await myResumeReview();
            if (!r) return 'Upload your resume first (your picture in the top right → Profile & settings → Upload resume). Then ask me again and I\'ll review it.';
            if (r.error) return 'I couldn\'t read your resume: ' + r.error;
            let msg = 'I read your resume (' + r.pages + ' page' + (r.pages > 1 ? 's' : '') + ', ' + r.words + ' words).\nScore: ' + r.score + '/100 (' + scoreLabel(r.score) + ')';
            if (r.good.length) msg += '\n\nWhat\'s working:\n' + r.good.map(x => '• ' + x.text).join('\n');
            if (r.fix.length) msg += '\n\nWhat to fix:\n' + r.fix.slice(0, 6).map(x => '• ' + x.text + (x.quote ? '\n   "' + shorten(x.quote, 80) + '"' : '')).join('\n');
            msg += '\n\nThe full review is in Profile & settings. A mentor can look at it too.';
            return msg;
        }


        /* ==============================================================
           GO!
           ============================================================== */
        fillMajors();
        document.addEventListener('click', e => {
            if (!e.target.closest('.me-spot')) $('menu').classList.add('hidden');
        });

        if (new URLSearchParams(location.search).has('demo')) {
            startDemo();
        } else {
            showLanding();
            if (sb) watchAuth();
        }
    </script>

</body>
</html>
