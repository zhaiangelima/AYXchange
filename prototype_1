        // Supabase tells us when someone signs in, signs out, or opens a reset link
        function watchAuth() {
            sb.auth.onAuthStateChange((event, session) => {
                // (Supabase asks us not to wait inside this, so we use setTimeout)
                setTimeout(() => {
                    if (event === 'PASSWORD_RECOVERY') {
                        recovering = true;
                        showAuth('newpass');
                    } else if ((event === 'SIGNED_IN' || event === 'INITIAL_SESSION') && session) {
                        openApp(session.user);
                    } else if (event === 'INITIAL_SESSION' && !session && $('auth').classList.contains('hidden') && !DEMO) {
                        showLanding();
                    }
                    // Clean up the address bar after an email link
                    if (location.hash.includes('access_token') || location.search.includes('code=')) {
